{%- comment -%} Kataloglar: kapak görseli + PDF bağlantısı. PDF yeni sekmede açılır. Blok yoksa görünmez. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section class="cats" aria-label="{{ page.title | escape }}">
    <ul class="cats__grid" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a class="cat" href="{{ block.settings.file_url }}" target="_blank" rel="noopener">
            <div class="cat__media">
              {%- if block.settings.image -%}
                {%- comment -%} İlk satır sayfanın en üstünde: tembel yükleme verilmez {%- endcomment -%}
                {%- assign cat_loading = 'lazy' -%}
                {%- if forloop.index <= 4 -%}{%- assign cat_loading = 'eager' -%}{%- endif -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: widths: '450,700,900', sizes: '(min-width: 64em) 24vw, 46vw', loading: cat_loading, alt: '' }}
              {%- endif -%}
            </div>
            <h2 class="cat__title">{{ block.settings.title }}</h2>
            <span class="cat__meta">
              <svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M7 3h7l4 4v14H7z M14 3v4h4 M10 13h6 M10 16.5h6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
              {{- 'pages.open_pdf' | t -}}
              <span class="visually-hidden"> ({{ 'general.new_tab' | t }})</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Kataloglar",
  "class": "section-page-catalogs",
  "blocks": [
    { "type": "catalog", "name": "Katalog", "limit": 24, "settings": [
      { "type": "text", "id": "title", "label": "Katalog adı" },
      { "type": "url", "id": "file_url", "label": "PDF bağlantısı", "info": "Shopify > İçerik > Dosyalar'a yüklenen PDF'in bağlantısı." },
      { "type": "image_picker", "id": "image", "label": "Kapak görseli" }
    ] }
  ],
  "presets": [{ "name": "Kataloglar" }]
}
{% endschema %}
