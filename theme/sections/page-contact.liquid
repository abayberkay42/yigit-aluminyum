{%- comment -%}
  İletişim: form yok (2026-09-15, müşteri isteği). Talepler WhatsApp'a yönlendirilir; numara Tema ayarları >
  İletişim düğmeleri'nden gelir (snippets/wa-href.liquid). Yanında telefon düğmesi ve iletişim bilgileri.
  Bilgi blokları yalnızca değer girilince görünür.
{%- endcomment -%}
{%- assign tel_no = settings.org_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
<section class="contact" aria-labelledby="ContactTitle-{{ section.id }}">
  <div class="contact__grid">
    <div class="door door--dark contact__wa">
      <p class="door__k">{{ 'general.dock.whatsapp' | t }}</p>
      <h2 class="door__title" id="ContactTitle-{{ section.id }}">{{ section.settings.cta_title }}</h2>
      {%- if section.settings.cta_text != blank -%}<p class="door__text">{{ section.settings.cta_text }}</p>{%- endif -%}
      {%- if section.settings.cta_items != blank -%}
        {%- assign satirlar = section.settings.cta_items | newline_to_br | split: '<br />' -%}
        <ul class="door__items" role="list">
          {%- for satir in satirlar -%}{%- assign s = satir | strip -%}{%- if s != blank -%}<li>{{ s }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}
      <div class="door__actions">
        <a class="button button--primary" href="{% render 'wa-href', mesaj: section.settings.cta_message %}" target="_blank" rel="noopener">{{ section.settings.cta_label }}<span class="visually-hidden"> (WhatsApp, {{ 'general.new_tab' | t }})</span></a>
        {%- if tel_no != blank -%}
          <a class="button button--ghost" href="tel:{{ tel_no }}">{{ 'general.dock.call' | t }}: {{ settings.org_phone }}</a>
        {%- endif -%}
      </div>
    </div>
    <aside class="contact__info" aria-label="{{ 'footer.contact' | t }}">
      {%- for block in section.blocks -%}
        {%- if block.settings.value != blank -%}
          <div class="info" {{ block.shopify_attributes }}>
            <p class="info__k">{{ block.settings.label }}</p>
            <p class="info__v">
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.value | newline_to_br }}</a>{%- else -%}{{ block.settings.value | newline_to_br }}{%- endif -%}
            </p>
            {%- if block.settings.extra_link != blank -%}
              <a class="info__more" href="{{ block.settings.extra_link }}" rel="noopener">{{ block.settings.extra_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </aside>
  </div>

  {%- comment -%}
    Mağazanın harita görünümü. Gizlilik ve sayfa hızı için harita açılışta yüklenmez:
    ziyaretçi düğmeye basınca Google Haritalar çerçevesi eklenir (src/js/sections/harita.js).
    JS yoksa "Google Haritalar'da aç" bağlantısı çalışır.
  {%- endcomment -%}
  {%- if section.settings.harita_adres != blank -%}
    {%- liquid
      assign sorgu = section.settings.harita_adres | strip | url_encode
      assign gomme = section.settings.harita_embed
      if gomme == blank
        assign gomme = 'https://www.google.com/maps?q=' | append: sorgu | append: '&hl=tr&z=16&output=embed'
      endif
      assign ac = section.settings.harita_link
      if ac == blank
        assign ac = 'https://www.google.com/maps/search/?api=1&query=' | append: sorgu
      endif
    -%}
    <div class="harita" data-harita data-embed="{{ gomme | escape }}">
      <div class="harita__ust">
        <div>
          <h2 class="harita__baslik">{{ section.settings.harita_baslik }}</h2>
          <p class="harita__adres">{{ section.settings.harita_adres | newline_to_br }}</p>
        </div>
        <a class="button button--ghost" href="{{ ac }}" target="_blank" rel="noopener">
          {{ 'pages.map_open' | t }}<span class="visually-hidden"> ({{ 'general.new_tab' | t }})</span>
        </a>
      </div>
      <div class="harita__kutu">
        {%- if section.settings.harita_gorsel -%}
          {{ section.settings.harita_gorsel | image_url: width: 1600 | image_tag: widths: '800,1200,1600', sizes: '100vw', loading: 'lazy', alt: '', class: 'harita__onizleme' }}
        {%- endif -%}
        <button type="button" class="button button--primary harita__ac" data-harita-ac>{{ 'pages.map_show' | t }}</button>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "İletişim",
  "class": "section-page-contact",
  "settings": [
    { "type": "text", "id": "cta_title", "label": "Başlık", "default": "Teklif için WhatsApp'tan yazın" },
    { "type": "textarea", "id": "cta_text", "label": "Metin", "default": "Ürünü, proje miktarını ve kullanılacak alanı yazın; doğru profili ve fiyatı birlikte belirleyelim." },
    { "type": "textarea", "id": "cta_items", "label": "Maddeler", "info": "Her satır bir madde.", "default": "Proje ve toptan fiyat teklifi\nÜrün seçimi ve teknik bilgi" },
    { "type": "text", "id": "cta_label", "label": "Düğme metni", "default": "Teklif alın" },
    { "type": "text", "id": "cta_message", "label": "WhatsApp hazır mesajı", "default": "Merhaba, fiyat teklifi almak istiyorum." },
    { "type": "header", "content": "Harita" },
    { "type": "textarea", "id": "harita_adres", "label": "Mağaza adresi", "info": "Boş bırakılırsa harita görünmez. Harita bu adrese göre açılır." },
    { "type": "text", "id": "harita_baslik", "label": "Harita başlığı", "default": "Mağazamız" },
    { "type": "url", "id": "harita_embed", "label": "Harita gömme bağlantısı", "info": "İsteğe bağlı. Google Haritalar > Paylaş > Harita yerleştir bölümündeki bağlantı. Boşsa adresten üretilir." },
    { "type": "url", "id": "harita_link", "label": "Haritada aç bağlantısı", "info": "İsteğe bağlı. Boşsa adresten üretilir." },
    { "type": "image_picker", "id": "harita_gorsel", "label": "Harita ön görseli", "info": "Harita yüklenmeden önce görünen kare. Boşsa düz zemin." }
  ],
  "blocks": [
    { "type": "item", "name": "Bilgi", "limit": 8, "settings": [
      { "type": "text", "id": "label", "label": "Başlık", "default": "Adres" },
      { "type": "textarea", "id": "value", "label": "Değer", "info": "Boş bırakılırsa görünmez." },
      { "type": "url", "id": "link", "label": "Değerin bağlantısı", "info": "Telefon için tel:+90..., e-posta için mailto:..., WhatsApp için https://wa.me/90..." },
      { "type": "url", "id": "extra_link", "label": "Ek bağlantı", "info": "Örnek: yol tarifi (Google Haritalar bağlantısı)." },
      { "type": "text", "id": "extra_label", "label": "Ek bağlantı metni", "default": "Yol tarifi al" }
    ] }
  ],
  "presets": [{ "name": "İletişim" }]
}
{% endschema %}
