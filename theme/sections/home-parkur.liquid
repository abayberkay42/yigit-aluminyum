{%- comment -%}
  Ana sayfa: "Üretim parkurumuz" bölümü. Altı durak kartı; her kart parkur sayfasındaki ilgili durağa gider.
  Kartlarda fotoğraf yoksa numara ve yazı kalır (fotoğraflar fabrikada çekilecek).
{%- endcomment -%}
{%- assign hedef = section.settings.page_url | default: '/pages/uretim-parkurumuz' -%}
<section class="hparkur" aria-labelledby="HParkurTitle-{{ section.id }}">
  <header class="hparkur__head">
    {%- if section.settings.eyebrow != blank -%}<p class="hparkur__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="hparkur__title" id="HParkurTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="hparkur__lede rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="hparkur__all" href="{{ hedef }}">
        {{ section.settings.link_label }}
        <svg class="icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    {%- endif -%}
  </header>

  <ol class="hparkur__grid" role="list">
    {%- for block in section.blocks -%}
      {%- assign no = block.settings.no | default: forloop.index | prepend: '0' | slice: -2, 2 -%}
      {%- capture url -%}{{ hedef }}{% if block.settings.anchor != blank %}#durak-{{ block.settings.anchor }}{% endif %}{%- endcapture -%}
      <li class="pkart reveal" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <a class="pkart__link" href="{{ url }}">
          {%- if block.settings.image -%}
            <span class="pkart__media">{{ block.settings.image | image_url: width: 900 | image_tag: widths: '300,600,900', sizes: '(min-width: 64em) 30vw, 85vw', loading: 'lazy', alt: '' }}</span>
          {%- endif -%}
          <span class="pkart__body">
            <span class="pkart__no" aria-hidden="true">{{ no }}</span>
            <span class="pkart__title">{{ block.settings.title }}</span>
            {%- if block.settings.text != blank -%}<span class="pkart__text">{{ block.settings.text }}</span>{%- endif -%}
          </span>
          <span class="pkart__go" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" focusable="false"><path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ol>
</section>

{% schema %}
{
  "name": "Üretim parkuru kart",
  "class": "section-home-parkur",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Üretim parkurumuz" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Profil, kalıptan sevkiyata altı duraktan geçiyor" },
    { "type": "richtext", "id": "text", "label": "Giriş metni" },
    { "type": "url", "id": "page_url", "label": "Parkur sayfası", "info": "Boşsa /pages/uretim-parkurumuz." },
    { "type": "text", "id": "link_label", "label": "Bağlantı metni", "default": "Üretim parkurumuzu inceleyin" }
  ],
  "blocks": [
    { "type": "durak", "name": "Durak", "limit": 8, "settings": [
      { "type": "text", "id": "no", "label": "Numara" },
      { "type": "text", "id": "title", "label": "Başlık", "default": "Durak" },
      { "type": "textarea", "id": "text", "label": "Kısa metin" },
      { "type": "image_picker", "id": "image", "label": "Fotoğraf" },
      { "type": "text", "id": "anchor", "label": "Sayfadaki durak kimliği", "info": "Parkur sayfasındaki durağın kimliği (ör. kaliphane)." }
    ] }
  ],
  "presets": [{ "name": "Üretim parkuru kart" }]
}
{% endschema %}
