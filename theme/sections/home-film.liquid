{%- comment -%}
  Ana sayfa filmi: tanıtım videosunun kareleri kaydırdıkça oynar (src/js/sections/film.js).
  İki örnek, iki ayrı video:
    - Masaüstü (yatay): yalnız 64em ve üstü, fare/dokunmatik yüzey kullanan ekranlar
    - Mobil (dikey): masaüstü kırılımının altındaki ekranlar (sitenin mobil düzeniyle aynı sınır)
  Her cihaz yalnız kendi karelerini indirir. Hareket azaltma açıksa son kare durağan gösterilir.

  Kareler Shopify > İçerik > Dosyalar'a "önek + sıra numarası" adıyla yüklenir:
    masaüstü: yigit-film-0001.webp … yigit-film-0944.webp
    mobil   : yigit-film-mobil-0001.webp … yigit-film-mobil-0361.webp
  Adresler file_url ile ilk kareden türetilir. Kareler tema içine konmaz (tema toplamı en fazla 50 MB);
  Shopify video olarak yüklenirse yeniden kodlar ve kaydırmada akıcılık bozulur, bu yüzden görsel olarak yüklenir.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign digits = s.frame_digits | default: 4
-%}
{%- render 'film-oynatici',
  sinif: 'film--masaustu',
  media: '(min-width: 64em) and (hover: hover) and (pointer: fine)',
  prefix: s.frame_prefix,
  count: s.frame_count,
  digits: digits,
  ext: s.frame_ext,
  width: s.frame_width,
  height: s.frame_height,
  scroll_length: s.scroll_length,
  bellek: 16,
  veri_koru: false
-%}
{%- if s.mobile_frame_count > 0 -%}
  {%- render 'film-oynatici',
    sinif: 'film--mobil',
    media: '(max-width: 63.99em)',
    prefix: s.mobile_frame_prefix,
    count: s.mobile_frame_count,
    digits: digits,
    ext: s.frame_ext,
    width: s.mobile_frame_width,
    height: s.mobile_frame_height,
    scroll_length: s.mobile_scroll_length,
    bellek: 8,
    veri_koru: true
  -%}
{%- endif -%}

{% schema %}
{
  "name": "Tanıtım filmi",
  "class": "section-home-film",
  "settings": [
    { "type": "paragraph", "content": "Masaüstü ve mobil için ayrı videolar. Kareler Shopify > İçerik > Dosyalar'a önek + sıra numarası adıyla yüklenir (örnek: yigit-film-0001.webp, yigit-film-mobil-0001.webp)." },
    { "type": "range", "id": "frame_digits", "label": "Sıra numarası hane sayısı", "min": 3, "max": 6, "step": 1, "default": 4 },
    {
      "type": "select", "id": "frame_ext", "label": "Dosya türü", "default": "webp",
      "options": [
        { "value": "webp", "label": "WebP" },
        { "value": "jpg", "label": "JPEG" },
        { "value": "png", "label": "PNG" }
      ]
    },
    { "type": "header", "content": "Masaüstü (yatay video)" },
    { "type": "text", "id": "frame_prefix", "label": "Kare adı öneki", "default": "yigit-film-" },
    { "type": "number", "id": "frame_count", "label": "Kare sayısı", "default": 944 },
    { "type": "number", "id": "frame_width", "label": "Kare genişliği (piksel)", "default": 2560 },
    { "type": "number", "id": "frame_height", "label": "Kare yüksekliği (piksel)", "default": 1440 },
    { "type": "range", "id": "scroll_length", "label": "Kaydırma uzunluğu", "info": "Ekran yüksekliğinin yüzdesi. Uzadıkça film daha yavaş ilerler.", "min": 200, "max": 800, "step": 50, "unit": "%", "default": 450 },
    { "type": "header", "content": "Mobil (dikey video)" },
    { "type": "text", "id": "mobile_frame_prefix", "label": "Kare adı öneki", "default": "yigit-film-mobil-" },
    { "type": "number", "id": "mobile_frame_count", "label": "Kare sayısı", "info": "0 yazılırsa telefonda film gösterilmez.", "default": 361 },
    { "type": "number", "id": "mobile_frame_width", "label": "Kare genişliği (piksel)", "default": 1080 },
    { "type": "number", "id": "mobile_frame_height", "label": "Kare yüksekliği (piksel)", "default": 1920 },
    { "type": "range", "id": "mobile_scroll_length", "label": "Kaydırma uzunluğu", "info": "Ekran yüksekliğinin yüzdesi.", "min": 200, "max": 800, "step": 50, "unit": "%", "default": 400 }
  ],
  "presets": [{ "name": "Tanıtım filmi" }]
}
{% endschema %}
