{%- comment -%}
  Ana sayfa: üretim kanıtı. Firmanın gerçek tesis fotoğrafları (Shopify Dosyalar) ve üretim sayfasına bağlantı.
  İlk fotoğraf büyük, sonraki ikisi yanında üst üste. Fotoğraflar ekrana girerken aşağıdan açılır (src/js/sections/reveal.js);
  hareket azaltmada doğrudan görünür. Fotoğraf yoksa bölüm görünmez.
{%- endcomment -%}
{%- assign photos = section.blocks | where: 'type', 'photo' -%}
{%- if photos.size > 0 -%}
  <section class="hprod" aria-labelledby="HprodTitle-{{ section.id }}">
    <div class="hprod__head">
      {%- if section.settings.eyebrow != blank -%}<p class="groups__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="groups__title" id="HprodTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="groups__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.link != blank -%}<a class="psec__more" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <div class="hprod__grid">
      {%- for block in photos limit: 3 -%}
        {%- if block.settings.image -%}
          <figure class="hprod__item" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- if forloop.first -%}{%- assign sizes = '(min-width: 64em) 62vw, 100vw' -%}{%- else -%}{%- assign sizes = '(min-width: 64em) 31vw, 100vw' -%}{%- endif -%}
            {{ block.settings.image | image_url: width: 2000 | image_tag: widths: '600,900,1200,1600,2000', sizes: sizes, loading: 'lazy', alt: block.settings.caption }}
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Üretim (ana sayfa)",
  "class": "section-home-production",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Üretim" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Kendi tesisimizde üretiyoruz" },
    { "type": "textarea", "id": "text", "label": "Metin" },
    { "type": "text", "id": "link_label", "label": "Bağlantı metni", "default": "Üretim sürecini inceleyin" },
    { "type": "url", "id": "link", "label": "Bağlantı", "default": "/pages/uretim" }
  ],
  "blocks": [
    { "type": "photo", "name": "Fotoğraf", "limit": 3, "settings": [
      { "type": "image_picker", "id": "image", "label": "Fotoğraf", "info": "Gerçek tesis fotoğrafı kullanılmalıdır. İlki büyük gösterilir." },
      { "type": "text", "id": "caption", "label": "Açıklama" }
    ] }
  ],
  "presets": [{ "name": "Üretim (ana sayfa)" }]
}
{% endschema %}
