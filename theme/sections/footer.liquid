{%- comment -%}
  Alt alan: marka satırı, sosyal medya, iki menü, iletişim, harita ve telif satırı. Sosyal medya adresleri
  tema ayarlarından gelir (Tema ayarları > Firma bilgileri > Sosyal medya adresleri); adres yoksa görünmez.
{%- endcomment -%}
<footer class="site-footer">
  <div class="site-footer__top">
    <div class="site-footer__brand">
      <p class="site-footer__mark">{%- render 'logo', class: 'site-footer__logo' -%}</p>
      {%- if section.settings.text != blank -%}<p class="site-footer__claim">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        {%- if section.settings.cta_whatsapp -%}
          <a class="button button--ghost site-footer__cta" href="{% render 'wa-href', mesaj: section.settings.cta_message %}" target="_blank" rel="noopener">{{ section.settings.cta_label }}<span class="visually-hidden"> (WhatsApp, {{ 'general.new_tab' | t }})</span></a>
        {%- elsif section.settings.cta_link != blank -%}
          <a class="button button--ghost site-footer__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      {%- endif -%}
      {%- comment -%} Sosyal medya: alt alanın marka sütununda, adlarıyla birlikte {%- endcomment -%}
      {%- render 'sosyal', etiket: true, baslik: section.settings.sosyal_baslik, sinif: 'site-footer__sosyal' -%}
    </div>

    {%- for key in (1..2) -%}
      {%- if key == 1 -%}
        {%- assign menu = section.settings.menu -%}{%- assign menu_heading = section.settings.menu_heading -%}
      {%- else -%}
        {%- assign menu = section.settings.menu_2 -%}{%- assign menu_heading = section.settings.menu_2_heading -%}
      {%- endif -%}
      {%- if menu != blank -%}
        <nav class="site-footer__col" aria-labelledby="FooterMenu-{{ key }}">
          <h2 class="site-footer__h" id="FooterMenu-{{ key }}">{{ menu_heading | default: menu.title }}</h2>
          <ul role="list">
            {%- for link in menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endfor -%}

    {%- liquid
      assign s = section.settings
      assign has_contact = false
      if s.address != blank or s.phone != blank or s.email != blank or s.whatsapp != blank
        assign has_contact = true
      endif
    -%}
    {%- if has_contact -%}
      <div class="site-footer__col">
        <h2 class="site-footer__h">{{ 'footer.contact' | t }}</h2>
        <address class="site-footer__contact">
          {%- if s.address != blank -%}<p>{{ s.address | newline_to_br }}</p>{%- endif -%}
          {%- if s.phone != blank -%}<p><a href="tel:{{ s.phone | remove: ' ' }}">{{ s.phone }}</a></p>{%- endif -%}
          {%- if s.email != blank -%}<p><a href="mailto:{{ s.email }}">{{ s.email }}</a></p>{%- endif -%}
          {%- if s.whatsapp != blank -%}<p><a href="{{ s.whatsapp }}" rel="noopener">{{ 'footer.whatsapp' | t }}</a></p>{%- endif -%}
        </address>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%}
    Yasal bildirim ve firma bilgileri: ayrı bir sayfada durmasın diye alt alanda, menülerin altında.
    Boş bırakılan satır görünmez; bağlantılar aynı "Yasal" menüsünden gelir.
  {%- endcomment -%}
  {%- liquid
    assign f = section.settings
    assign firma_var = false
    if f.unvan != blank or f.sahip != blank or f.ito_adres != blank or f.vergi_dairesi != blank or f.sicil != blank or f.oda != blank or f.oda_sicil != blank or f.saatler != blank
      assign firma_var = true
    endif
  -%}
  {%- if firma_var or f.menu_yasal != blank -%}
    <div class="site-footer__firma">
      <h2 class="site-footer__h">{{ f.firma_baslik }}</h2>
      {%- if firma_var -%}
        <dl class="firma__liste">
          {%- if f.unvan != blank -%}<div><dt>Ticaret unvanı</dt><dd>{{ f.unvan }}</dd></div>{%- endif -%}
          {%- if f.sahip != blank -%}<div><dt>İşletme sahibi</dt><dd>{{ f.sahip }}</dd></div>{%- endif -%}
          {%- if f.ito_adres != blank -%}<div><dt>Kayıtlı iş adresi</dt><dd>{{ f.ito_adres }}</dd></div>{%- endif -%}
          {%- if f.vergi_dairesi != blank -%}<div><dt>Vergi dairesi</dt><dd>{{ f.vergi_dairesi }}</dd></div>{%- endif -%}
          {%- if f.sicil != blank -%}<div><dt>Ticaret sicil numarası</dt><dd>{{ f.sicil }}</dd></div>{%- endif -%}
          {%- if f.oda != blank -%}<div><dt>Kayıtlı olduğu oda</dt><dd>{{ f.oda }}{% if f.oda_sicil != blank %}, sicil no {{ f.oda_sicil }}{% endif %}</dd></div>{%- endif -%}
          {%- if f.saatler != blank -%}<div><dt>Müşteri hizmetleri</dt><dd>{{ f.saatler }}</dd></div>{%- endif -%}
        </dl>
      {%- endif -%}
      {%- if f.menu_yasal != blank -%}
        <nav class="site-footer__yasal" aria-label="{{ f.yasal_baslik | default: 'Yasal metinler' }}">
          <ul class="site-footer__yasal-liste" role="list">
            {%- for link in f.menu_yasal.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} Mağaza haritası her sayfanın altında; ekrana girince yüklenir {%- endcomment -%}
  {%- if section.settings.harita_goster -%}
    <div class="site-footer__harita">{%- render 'harita', kompakt: true -%}</div>
  {%- endif -%}

  <div class="site-footer__base">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Alt alan",
  "class": "section-footer",
  "settings": [
    { "type": "textarea", "id": "text", "label": "Marka altı metin", "default": "2008'den beri alüminyum profil üretiyoruz." },
    { "type": "text", "id": "cta_label", "label": "Düğme metni", "default": "Teklif alın" },
    { "type": "checkbox", "id": "cta_whatsapp", "label": "Düğme WhatsApp'a yönlendirsin", "default": true, "info": "Numara Tema ayarları > İletişim düğmeleri'nden gelir." },
    { "type": "text", "id": "cta_message", "label": "WhatsApp hazır mesajı", "default": "Merhaba, fiyat teklifi almak istiyorum." },
    { "type": "url", "id": "cta_link", "label": "Düğme bağlantısı (WhatsApp kapalıysa)" },
    { "type": "link_list", "id": "menu", "label": "Birinci menü", "default": "footer" },
    { "type": "text", "id": "menu_heading", "label": "Birinci menü başlığı", "default": "Mağaza" },
    { "type": "link_list", "id": "menu_2", "label": "İkinci menü", "default": "main-menu" },
    { "type": "text", "id": "menu_2_heading", "label": "İkinci menü başlığı", "default": "Sayfalar" },
    { "type": "header", "content": "İletişim (boş bırakılan görünmez)" },
    { "type": "textarea", "id": "address", "label": "Adres" },
    { "type": "text", "id": "phone", "label": "Telefon" },
    { "type": "text", "id": "email", "label": "E-posta" },
    { "type": "url", "id": "whatsapp", "label": "WhatsApp bağlantısı", "info": "Örnek: https://wa.me/90..." },
    { "type": "text", "id": "sosyal_baslik", "label": "Sosyal medya başlığı", "default": "Bizi takip edin" },
    { "type": "header", "content": "Yasal bildirim ve firma bilgileri (boş bırakılan görünmez)" },
    { "type": "text", "id": "firma_baslik", "label": "Başlık", "default": "Yasal bildirim ve firma bilgileri" },
    { "type": "link_list", "id": "menu_yasal", "label": "Yasal metinler menüsü", "info": "Firma bilgilerinin altında bağlantı satırı olarak görünür." },
    { "type": "text", "id": "unvan", "label": "Ticaret unvanı", "default": "MUSTAFA YİĞİT YİĞİT ALÜMİNYUM PROFİL (şahıs işletmesi)" },
    { "type": "text", "id": "sahip", "label": "İşletme sahibi", "default": "MUSTAFA YİĞİT" },
    { "type": "textarea", "id": "ito_adres", "label": "Kayıtlı iş adresi", "default": "Beylikdüzü OSB Mah. Birlik Sanayi Sitesi 2. Cad. No: 1/1/17 Beylikdüzü / İstanbul" },
    { "type": "text", "id": "vergi_dairesi", "label": "Vergi dairesi", "default": "Beylikdüzü Vergi Dairesi" },
    { "type": "text", "id": "sicil", "label": "Ticaret sicil numarası", "default": "343185-5" },
    { "type": "text", "id": "oda", "label": "Kayıtlı olduğu oda", "default": "İstanbul Ticaret Odası" },
    { "type": "text", "id": "oda_sicil", "label": "Oda sicil numarası", "default": "1333622" },
    { "type": "text", "id": "saatler", "label": "Müşteri hizmetleri saatleri", "default": "Pazartesi-Cuma 09.00-18.00, Cumartesi 09.00-12.00" },
    { "type": "checkbox", "id": "harita_goster", "label": "Alt alanda harita göster", "default": true, "info": "Adres ve bağlantı Tema ayarları > Harita'dan gelir." }
  ]
}
{% endschema %}
