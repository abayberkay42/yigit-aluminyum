{%- comment -%}
  Alt alan: marka satırı, iki menü, iletişim ve telif satırı. Sosyal medya adresleri tema ayarlarından gelir
  (Tema ayarları > Firma bilgileri > Sosyal medya adresleri); adres yoksa simgeler görünmez.
{%- endcomment -%}
{%- assign socials = settings.org_same_as | strip | newline_to_br | split: '<br />' -%}
<footer class="site-footer">
  <div class="site-footer__top">
    <div class="site-footer__brand">
      <p class="site-footer__mark">{%- render 'logo', class: 'site-footer__logo' -%}</p>
      {%- if section.settings.text != blank -%}<p class="site-footer__claim">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        {%- if section.settings.cta_whatsapp -%}
          <a class="button button--ghost site-footer__cta" href="{% render 'wa-href', mesaj: section.settings.cta_message %}" target="_blank" rel="noopener">{{ section.settings.cta_label }}<span class="visually-hidden"> (WhatsApp, {{ 'general.new_tab' | t }})</span></a>
        {%- elsif section.settings.cta_link != blank -%}
          <a class="button button--ghost site-footer__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- for key in (1..2) -%}
      {%- if key == 1 -%}
        {%- assign menu = section.settings.menu -%}{%- assign menu_heading = section.settings.menu_heading -%}
      {%- else -%}
        {%- assign menu = section.settings.menu_2 -%}{%- assign menu_heading = section.settings.menu_2_heading -%}
      {%- endif -%}
      {%- if menu != blank -%}
        <nav class="site-footer__col" aria-labelledby="FooterMenu-{{ key }}">
          <h2 class="site-footer__h" id="FooterMenu-{{ key }}">{{ menu_heading | default: menu.title }}</h2>
          <ul role="list">
            {%- for link in menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endfor -%}

    {%- liquid
      assign s = section.settings
      assign has_contact = false
      if s.address != blank or s.phone != blank or s.email != blank or s.whatsapp != blank
        assign has_contact = true
      endif
    -%}
    {%- if has_contact -%}
      <div class="site-footer__col">
        <h2 class="site-footer__h">{{ 'footer.contact' | t }}</h2>
        <address class="site-footer__contact">
          {%- if s.address != blank -%}<p>{{ s.address | newline_to_br }}</p>{%- endif -%}
          {%- if s.phone != blank -%}<p><a href="tel:{{ s.phone | remove: ' ' }}">{{ s.phone }}</a></p>{%- endif -%}
          {%- if s.email != blank -%}<p><a href="mailto:{{ s.email }}">{{ s.email }}</a></p>{%- endif -%}
          {%- if s.whatsapp != blank -%}<p><a href="{{ s.whatsapp }}" rel="noopener">{{ 'footer.whatsapp' | t }}</a></p>{%- endif -%}
        </address>
      </div>
    {%- endif -%}
  </div>

  <div class="site-footer__base">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    {%- if settings.org_same_as != blank -%}
      <ul class="site-footer__social" role="list" aria-label="{{ 'footer.social' | t }}">
        {%- for item in socials -%}
          {%- assign url = item | strip -%}
          {%- if url == blank -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign name = 'Web'
            if url contains 'instagram'
              assign name = 'Instagram'
            elsif url contains 'facebook'
              assign name = 'Facebook'
            elsif url contains 'youtube'
              assign name = 'YouTube'
            elsif url contains 'linkedin'
              assign name = 'LinkedIn'
            endif
          -%}
          <li>
            <a href="{{ url }}" rel="noopener" target="_blank">
              <span class="visually-hidden">{{ name }} ({{ 'general.new_tab' | t }})</span>
              {%- case name -%}
                {%- when 'Instagram' -%}
                  <svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"/></svg>
                {%- when 'Facebook' -%}
                  <svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M14.5 21v-7h2.4l.4-3h-2.8V9.2c0-.9.3-1.5 1.5-1.5H17.4V5.1C17.1 5 16.2 4.9 15.2 4.9c-2.1 0-3.6 1.3-3.6 3.8V11H9v3h2.6v7z" fill="currentColor"/></svg>
                {%- when 'YouTube' -%}
                  <svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><rect x="2.5" y="5.5" width="19" height="13" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10.5 9.5l5 2.5-5 2.5z" fill="currentColor"/></svg>
                {%- when 'LinkedIn' -%}
                  <svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="3" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M7.5 10v6.5M7.5 7.2v.1M11 16.5V10m0 2.2c.3-1.3 1.3-2.2 2.7-2.2 1.6 0 2.8 1 2.8 3v3.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                {%- else -%}
                  <svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 12h17M12 3.5c4 4.5 4 12.5 0 17-4-4.5-4-12.5 0-17z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
              {%- endcase -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Alt alan",
  "class": "section-footer",
  "settings": [
    { "type": "textarea", "id": "text", "label": "Marka altı metin", "default": "2008'den beri alüminyum profil üretiyoruz." },
    { "type": "text", "id": "cta_label", "label": "Düğme metni", "default": "Teklif alın" },
    { "type": "checkbox", "id": "cta_whatsapp", "label": "Düğme WhatsApp'a yönlendirsin", "default": true, "info": "Numara Tema ayarları > İletişim düğmeleri'nden gelir." },
    { "type": "text", "id": "cta_message", "label": "WhatsApp hazır mesajı", "default": "Merhaba, fiyat teklifi almak istiyorum." },
    { "type": "url", "id": "cta_link", "label": "Düğme bağlantısı (WhatsApp kapalıysa)" },
    { "type": "link_list", "id": "menu", "label": "Birinci menü", "default": "footer" },
    { "type": "text", "id": "menu_heading", "label": "Birinci menü başlığı", "default": "Mağaza" },
    { "type": "link_list", "id": "menu_2", "label": "İkinci menü", "default": "main-menu" },
    { "type": "text", "id": "menu_2_heading", "label": "İkinci menü başlığı", "default": "Sayfalar" },
    { "type": "header", "content": "İletişim (boş bırakılan görünmez)" },
    { "type": "textarea", "id": "address", "label": "Adres" },
    { "type": "text", "id": "phone", "label": "Telefon" },
    { "type": "text", "id": "email", "label": "E-posta" },
    { "type": "url", "id": "whatsapp", "label": "WhatsApp bağlantısı", "info": "Örnek: https://wa.me/90..." }
  ]
}
{% endschema %}
