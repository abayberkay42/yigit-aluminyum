{%- comment -%} Ürün sayfası: üretim bandı; üretim sayfasına yönlendirir. Görsel isteğe bağlı (gerçek tesis görseli). {%- endcomment -%}
<section class="psec pprod{% if section.settings.image %} pprod--media{% endif %}" aria-labelledby="Prod-{{ section.id }}">
  <div class="pprod__body">
    <h2 class="psec__title" id="Prod-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="pprod__text">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.link != blank -%}<a class="button button--primary" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{%- endif -%}
  </div>
  {%- if section.settings.image -%}
    <div class="pprod__media">{{ section.settings.image | image_url: width: 1200 | image_tag: widths: '600,900,1200', sizes: '(min-width: 64em) 40vw, 90vw', loading: 'lazy', alt: '' }}</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Üretim bandı",
  "class": "section-product-production",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Üreticiden doğrudan" },
    { "type": "textarea", "id": "text", "label": "Metin", "default": "Yiğit Alüminyum 2008'den beri alüminyum profil üretiyor. Kalıptan sevkiyata kadar üretim sürecimizi inceleyin." },
    { "type": "text", "id": "link_label", "label": "Bağlantı metni", "default": "Üretim sürecini inceleyin" },
    { "type": "url", "id": "link", "label": "Bağlantı", "default": "/pages/uretim" },
    { "type": "image_picker", "id": "image", "label": "Görsel", "info": "Gerçek tesis görseli kullanılmalıdır." }
  ],
  "presets": [{ "name": "Üretim bandı" }]
}
{% endschema %}
