{%- comment -%}
  Ürün sayfası: LED şerit karşılaştırması (60 / 120 / 240 çipli). Firmanın "Tüm LED profilleri için ürün sayfası
  içerikleri" klasöründen (2026-09-19). Her satır: şerit adı, kısa açıklama, geniş şerit görseli (solu kapaksız,
  sağı difüzör kapaklı görünüm). Önerilen satırda altın çerçeve ve "Önerilen seçim" etiketi.
  "Görünüm" ayarı: satırlar, satırlar + özet görsel ya da yalnız özet görsel. Yalnız özet görselde satırlar görünmez
  metin olarak kalır (görseldeki yazıyı arama motoru ve ekran okuyucu okuyamaz), şerit görselleri hiç basılmaz.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign gorunum = s.gorunum | default: 'kart'
  if s.yalniz_ozet and s.gorunum == blank
    assign gorunum = 'ozet'
  endif
  assign yalniz = false
  if gorunum == 'ozet' and s.ozet
    assign yalniz = true
  endif
-%}
{%- if section.blocks.size > 0 or s.ozet -%}
  <section class="psec serit{% if yalniz %} psec--ozet{% endif %}" aria-labelledby="Serit-{{ section.id }}">
    <div class="psec__head{% if yalniz %} visually-hidden{% endif %}">
      <h2 class="psec__title" id="Serit-{{ section.id }}">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="psec__text">{{ s.text }}</p>{%- endif -%}
    </div>

    {%- if yalniz -%}
      {%- render 'rehber-gorsel', gorsel: s.ozet, alt: s.heading -%}
      <ul class="visually-hidden">
        {%- for block in section.blocks -%}
          <li>{{ block.settings.title }}{% if block.settings.text != blank %}: {{ block.settings.text }}{% endif %}{% if block.settings.onerilen %} ({{ s.onerilen_etiket }}){% endif %}</li>
        {%- endfor -%}
      </ul>
      {%- if s.note != blank -%}<p class="visually-hidden">{{ s.note }}</p>{%- endif -%}
    {%- else -%}
      {%- if s.sol_etiket != blank or s.sag_etiket != blank -%}
        <div class="serit__sutunlar" aria-hidden="true"><span>{{ s.sol_etiket }}</span><span>{{ s.sag_etiket }}</span></div>
      {%- endif -%}
      <ul class="serit__liste" role="list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li class="serit__satir{% if b.onerilen %} serit__satir--onerilen{% endif %}" {{ block.shopify_attributes }}>
            <div class="serit__ust">
              <div>
                <h3 class="serit__ad">{{ b.title }}</h3>
                {%- if b.text != blank -%}<p class="serit__acik">{{ b.text }}</p>{%- endif -%}
              </div>
              {%- if b.onerilen and s.onerilen_etiket != blank -%}
                <p class="serit__rozet">
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {{ s.onerilen_etiket }}
                </p>
              {%- endif -%}
            </div>
            {%- if b.image -%}
              <div class="serit__gorsel" style="aspect-ratio: {{ b.image.aspect_ratio }}">
                {{ b.image | image_url: width: 2200 | image_tag: widths: '800,1200,1600,2200', sizes: '(min-width: 86rem) 84rem, 96vw', loading: 'lazy', alt: b.title }}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- if s.note != blank -%}<p class="cmp__not">{{ s.note }}</p>{%- endif -%}
      {%- if gorunum == 'ikisi' -%}{%- render 'rehber-gorsel', gorsel: s.ozet, alt: s.heading -%}{%- endif -%}
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "LED şerit karşılaştırması",
  "class": "section-product-serit",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "LED şerit karşılaştırması" },
    { "type": "textarea", "id": "text", "label": "Metin" },
    { "type": "text", "id": "sol_etiket", "label": "Görselin sol yarısı", "default": "Kapaksız görünüm" },
    { "type": "text", "id": "sag_etiket", "label": "Görselin sağ yarısı", "default": "Difüzör kapaklı görünüm" },
    { "type": "text", "id": "onerilen_etiket", "label": "Önerilen etiketi", "default": "Önerilen seçim" },
    { "type": "text", "id": "note", "label": "Not", "default": "Aynı profil ve difüzör için temsili karşılaştırma." },
    { "type": "image_picker", "id": "ozet", "label": "Özet görsel", "info": "Karşılaştırmanın tek görsellik hâli (firmanın görseli)." },
    { "type": "select", "id": "gorunum", "label": "Görünüm", "default": "kart", "options": [
      { "value": "kart", "label": "Satırlar" },
      { "value": "ikisi", "label": "Satırlar ve özet görsel" },
      { "value": "ozet", "label": "Yalnız özet görsel" }
    ], "info": "Yalnız özet görselde ekranda tek görsel kalır; içerik arama motorları ve ekran okuyucular için sayfada görünmez metin olarak durur." }
  ],
  "blocks": [
    { "type": "serit", "name": "Şerit", "limit": 6, "settings": [
      { "type": "text", "id": "title", "label": "Ad", "default": "LED şerit" },
      { "type": "text", "id": "text", "label": "Açıklama" },
      { "type": "image_picker", "id": "image", "label": "Görsel", "info": "Geniş, yatay: solu kapaksız, sağı difüzör kapaklı görünüm." },
      { "type": "checkbox", "id": "onerilen", "label": "Önerilen seçim", "default": false }
    ] }
  ],
  "presets": [{ "name": "LED şerit karşılaştırması" }]
}
{% endschema %}
