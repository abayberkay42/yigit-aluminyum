{%- comment -%}
  Ana sayfa kapanışı: iki yol. Proje ve toptan (teklif WhatsApp'tan, bayilik) ile doğrudan satın alma (mağaza).
  Her kartın üst kenarında menüdeki LED çizgisinin aynısı var; kartın üzerine gelince yanar.
  "Maddeler" alanında her satır bir madde olur.
{%- endcomment -%}
<section class="doors" aria-labelledby="DoorsTitle-{{ section.id }}">
  <h2 class="doors__title" id="DoorsTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
  <div class="doors__grid">
    {%- for block in section.blocks -%}
      {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
      <article class="door door--{{ block.settings.style }}" {{ block.shopify_attributes }}>
        {%- if block.settings.eyebrow != blank -%}
          <p class="door__k">{{ block.settings.eyebrow }}</p>
        {%- endif -%}
        <h3 class="door__title">{{ block.settings.title }}</h3>
        {%- if block.settings.text != blank -%}
          <p class="door__text">{{ block.settings.text }}</p>
        {%- endif -%}
        {%- if block.settings.items != blank -%}
          <ul class="door__items" role="list">
            {%- for item in items -%}
              {%- assign line = item | strip -%}
              {%- if line != blank -%}<li>{{ line }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <div class="door__actions">
          {%- if block.settings.link_1_label != blank -%}
            {%- if block.settings.link_1_whatsapp -%}
              <a class="button button--primary" href="{% render 'wa-href', mesaj: block.settings.link_1_message %}" target="_blank" rel="noopener">{{ block.settings.link_1_label }}<span class="visually-hidden"> (WhatsApp, {{ 'general.new_tab' | t }})</span></a>
            {%- elsif block.settings.link_1 != blank -%}
              <a class="button button--primary" href="{{ block.settings.link_1 }}">{{ block.settings.link_1_label }}</a>
            {%- endif -%}
          {%- endif -%}
          {%- if block.settings.link_2_label != blank and block.settings.link_2 != blank -%}
            <a class="button button--ghost" href="{{ block.settings.link_2 }}">{{ block.settings.link_2_label }}</a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "İki yol",
  "class": "section-home-doors",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Nasıl çalışmak istersiniz?" }
  ],
  "blocks": [
    {
      "type": "door",
      "name": "Kart",
      "limit": 2,
      "settings": [
        { "type": "select", "id": "style", "label": "Görünüm", "default": "light", "options": [
          { "value": "dark", "label": "Öne çıkan (altın ışık)" },
          { "value": "light", "label": "Sade" }
        ] },
        { "type": "text", "id": "eyebrow", "label": "Üst etiket" },
        { "type": "text", "id": "title", "label": "Başlık", "default": "Başlık" },
        { "type": "textarea", "id": "text", "label": "Metin" },
        { "type": "textarea", "id": "items", "label": "Maddeler", "info": "Her satır bir madde." },
        { "type": "text", "id": "link_1_label", "label": "Birinci düğme metni" },
        { "type": "checkbox", "id": "link_1_whatsapp", "label": "Birinci düğme WhatsApp'a yönlendirsin", "default": false, "info": "Teklif düğmeleri için. Numara Tema ayarları > İletişim düğmeleri'nden gelir." },
        { "type": "text", "id": "link_1_message", "label": "WhatsApp hazır mesajı", "default": "Merhaba, fiyat teklifi almak istiyorum." },
        { "type": "url", "id": "link_1", "label": "Birinci düğme bağlantısı (WhatsApp kapalıysa)" },
        { "type": "text", "id": "link_2_label", "label": "İkinci düğme metni" },
        { "type": "url", "id": "link_2", "label": "İkinci düğme bağlantısı" }
      ]
    }
  ],
  "presets": [{ "name": "İki yol" }]
}
{% endschema %}
