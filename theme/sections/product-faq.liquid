{%- comment -%}
  Sıkça sorulan sorular: yerel <details> akordeon (JS gerekmez) + FAQPage yapılandırılmış verisi.
  Soru yoksa bölüm görünmez.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section class="psec faq" aria-labelledby="Faq-{{ section.id }}">
    <div class="psec__head">
      <h2 class="psec__title" id="Faq-{{ section.id }}">{{ section.settings.heading }}</h2>
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.shopify_attributes }}>
          <summary class="faq__q">{{ block.settings.question }}</summary>
          <div class="faq__a rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for block in section.blocks -%}{"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | strip | json }}}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
    </script>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Sıkça sorulan sorular",
  "class": "section-product-faq",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Sıkça sorulan sorular" }
  ],
  "blocks": [
    { "type": "question", "name": "Soru", "limit": 20, "settings": [
      { "type": "text", "id": "question", "label": "Soru" },
      { "type": "richtext", "id": "answer", "label": "Cevap" }
    ] }
  ],
  "presets": [{ "name": "Sıkça sorulan sorular" }]
}
{% endschema %}
