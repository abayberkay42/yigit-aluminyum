{%- comment -%}
  Ana sayfa ürün grupları: solda grup listesi, sağda seçili grubun ürün fotoğrafı ve öne çıkan ürünleri.
  Satırın üzerine gelmek ya da klavyeyle odaklanmak sağdaki paneli değiştirir (src/js/sections/groups.js).
  Görsel: blok görseli seçilmemişse grubun ilk ürününün ana görseli kullanılır.
{%- endcomment -%}
<section class="groups" data-groups aria-labelledby="GroupsTitle-{{ section.id }}">
  <header class="groups__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="groups__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="groups__title" id="GroupsTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="groups__text">{{ section.settings.text }}</p>
    {%- endif -%}
  </header>

  <div class="groups__body">
    <ol class="groups__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c == blank -%}{%- continue -%}{%- endif -%}
        {%- assign img = block.settings.image | default: c.products.first.featured_image | default: c.image -%}
        {%- assign no = forloop.index | prepend: '0' | slice: -2, 2 -%}
        <li class="group-row" data-group="{{ forloop.index0 }}"{% if forloop.first %} data-active{% endif %} {{ block.shopify_attributes }}>
          <a class="group-row__link" href="{{ c.url }}">
            <span class="group-row__no">{{ no }}</span>
            <span class="group-row__title">{{ block.settings.title | default: c.title }}</span>
            <span class="group-row__count">{{ 'collections.count' | t: count: c.products_count }}</span>
            {%- if img -%}
              <span class="group-row__thumb">{{ img | image_url: width: 240 | image_tag: widths: '160,240', sizes: '5rem', loading: 'lazy', alt: '' }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ol>

    <div class="groups__stage">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c == blank -%}{%- continue -%}{%- endif -%}
        {%- assign img = block.settings.image | default: c.products.first.featured_image | default: c.image -%}
        <div class="group-panel" data-panel="{{ forloop.index0 }}"{% if forloop.first %} data-active{% else %} inert{% endif %}>
          <div class="group-panel__media">
            {%- if img -%}
              {{ img | image_url: width: 1080 | image_tag: widths: '540,720,1080', sizes: '(min-width: 64em) 40vw, 90vw', loading: 'lazy', alt: img.alt }}
            {%- endif -%}
          </div>
          <div class="group-panel__meta">
            <p class="group-panel__k">{{ 'home.groups.featured' | t }}</p>
            <ul role="list">
              {%- for p in c.products limit: 3 -%}
                <li><a href="{{ p.url }}">{{ p.title }}</a></li>
              {%- endfor -%}
            </ul>
            <a class="button button--primary" href="{{ c.url }}">{{ 'home.hero.view_group' | t }}</a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ürün grupları",
  "class": "section-home-groups",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Ürün grupları" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Profil gruplarımız" },
    { "type": "textarea", "id": "text", "label": "Metin" }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Ürün grubu",
      "limit": 12,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Koleksiyon" },
        { "type": "text", "id": "title", "label": "Görünen ad", "info": "Boş bırakılırsa koleksiyonun adı kullanılır." },
        { "type": "image_picker", "id": "image", "label": "Görsel", "info": "Boş bırakılırsa grubun ilk ürününün görseli kullanılır." }
      ]
    }
  ],
  "presets": [{ "name": "Ürün grupları" }]
}
{% endschema %}
