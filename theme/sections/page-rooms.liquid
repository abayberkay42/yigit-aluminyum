{%- comment -%}
  Kullanım alanları: odalar tek tek, üstte yapışık oda listesi (src/js/sections/rooms.js etkin odayı işaretler).
  Her odada görsel üzerinde en çok üç ürün noktası: ürün + görseldeki konum (yüzde). Nokta ürün sayfasına götürür.
  Görsel üzerindeki ışık katmanı menüdeki ışık sıcaklığı seçimini fotoğrafa taşır.
{%- endcomment -%}
<section class="rooms" data-rooms aria-label="{{ page.title | escape }}">
  {%- if section.blocks.size > 1 -%}
    <nav class="rooms__nav" aria-label="{{ 'pages.rooms_nav' | t }}">
      <ul role="list">
        {%- for block in section.blocks -%}
          <li><a href="#room-{{ block.id }}" data-room-link>{{ block.settings.title }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- assign img = block.settings.image -%}
    <article class="room" id="room-{{ block.id }}" aria-labelledby="RoomTitle-{{ block.id }}" {{ block.shopify_attributes }}>
      <div class="room__media">
        {%- if img -%}
          {%- comment -%} İlk oda sayfanın en üstünde: tembel yükleme verilmez {%- endcomment -%}
          {%- assign room_loading = 'lazy' -%}
          {%- if forloop.first -%}{%- assign room_loading = 'eager' -%}{%- endif -%}
          {{ img | image_url: width: 2400 | image_tag: widths: '800,1200,1600,2400', sizes: '(min-width: 64em) 64vw, 100vw', loading: room_loading, alt: block.settings.title }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'room__placeholder' }}
        {%- endif -%}
        {%- for i in (1..3) -%}
          {%- capture pk -%}spot_{{ i }}_product{%- endcapture -%}
          {%- capture xk -%}spot_{{ i }}_x{%- endcapture -%}
          {%- capture yk -%}spot_{{ i }}_y{%- endcapture -%}
          {%- assign sp = block.settings[pk] -%}
          {%- if sp != blank -%}
            {%- assign x = block.settings[xk] -%}
            {%- assign y = block.settings[yk] -%}
            <a class="spot{% if x > 62 %} spot--flip{% endif %}" href="{{ sp.url }}" style="--x: {{ x }}%; --y: {{ y }}%;">
              <span class="spot__dot" aria-hidden="true"></span>
              <span class="spot__label">{{ sp.title }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="room__body">
        <h2 class="room__title" id="RoomTitle-{{ block.id }}">{{ block.settings.title }}</h2>
        {%- if block.settings.text != blank -%}<p class="room__text">{{ block.settings.text }}</p>{%- endif -%}
        {%- if block.settings.collections != blank -%}
          <ul class="room__groups" role="list" aria-label="{{ 'pages.room_groups' | t }}">
            {%- for c in block.settings.collections -%}
              <li><a href="{{ c.url }}">{{ c.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </article>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Kullanım alanları",
  "class": "section-page-rooms",
  "blocks": [
    {
      "type": "room",
      "name": "Oda",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "title", "label": "Oda adı", "default": "Salon" },
        { "type": "textarea", "id": "text", "label": "Metin" },
        { "type": "image_picker", "id": "image", "label": "Görsel", "info": "3:2 yatay, en az 2400 piksel genişlik." },
        { "type": "collection_list", "id": "collections", "label": "İlgili ürün grupları", "limit": 4 },
        { "type": "header", "content": "Görsel üzerindeki ürün noktaları" },
        { "type": "product", "id": "spot_1_product", "label": "1. nokta: ürün" },
        { "type": "range", "id": "spot_1_x", "label": "1. nokta: yatay konum (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "spot_1_y", "label": "1. nokta: dikey konum (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "product", "id": "spot_2_product", "label": "2. nokta: ürün" },
        { "type": "range", "id": "spot_2_x", "label": "2. nokta: yatay konum (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "spot_2_y", "label": "2. nokta: dikey konum (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "product", "id": "spot_3_product", "label": "3. nokta: ürün" },
        { "type": "range", "id": "spot_3_x", "label": "3. nokta: yatay konum (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "spot_3_y", "label": "3. nokta: dikey konum (%)", "min": 0, "max": 100, "step": 1, "default": 50 }
      ]
    }
  ],
  "presets": [{ "name": "Kullanım alanları" }]
}
{% endschema %}
