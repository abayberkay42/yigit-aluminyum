{%- comment -%}
  Ürün sayfası: adım adım anlatım (uygulama, kapak takma). Grup şablonunda tanımlanır; video isteğe bağlı.
  Adımlar sıralı olduğu için numaralıdır. Adım yoksa ve video yoksa bölüm görünmez.
  Adım görselleri kendi oranında gösterilir (kırpılmaz). "Özet görsel" doluysa bölümün altında tam genişlikte gösterilir.
  "Yalnız özet görseli göster" açıksa ekranda yalnız özet görsel kalır; başlık ve adımlar görünmez metin olarak durur
  (görseldeki yazıyı arama motoru ve ekran okuyucu okuyamaz). Adım görselleri o zaman hiç basılmaz, inmez.
{%- endcomment -%}
{%- liquid
  assign yalniz = false
  if section.settings.yalniz_ozet and section.settings.ozet
    assign yalniz = true
  endif
-%}
{%- if section.blocks.size > 0 or section.settings.video != blank -%}
  <section class="psec guide{% if yalniz %} psec--ozet{% endif %}" aria-labelledby="Guide-{{ section.id }}">
    <div class="psec__head{% if yalniz %} visually-hidden{% endif %}">
      <h2 class="psec__title" id="Guide-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="psec__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    {%- if yalniz -%}
      {%- render 'rehber-gorsel', gorsel: section.settings.ozet, alt: section.settings.heading -%}
      <ol class="visually-hidden">
        {%- for block in section.blocks -%}
          <li>{{ block.settings.title }}{% if block.settings.text != blank %}: {{ block.settings.text }}{% endif %}</li>
        {%- endfor -%}
      </ol>
    {%- else -%}
    {%- if section.settings.video != blank -%}
      <div class="guide__video">{{ section.settings.video | video_tag: controls: true, preload: 'none', image_size: '1600x' }}</div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ol class="guide__steps" role="list">
        {%- for block in section.blocks -%}
          <li class="gstep" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <div class="gstep__media" style="aspect-ratio: {{ block.settings.image.aspect_ratio }}">{{ block.settings.image | image_url: width: 800 | image_tag: widths: '400,600,800', sizes: '(min-width: 64em) 22vw, 90vw', loading: 'lazy', alt: block.settings.title }}</div>
            {%- endif -%}
            <p class="gstep__no" aria-hidden="true">{{ forloop.index }}</p>
            <h3 class="gstep__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p class="gstep__text">{{ block.settings.text }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
    {%- render 'rehber-gorsel', gorsel: section.settings.ozet, alt: section.settings.heading -%}
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Adım adım anlatım",
  "class": "section-product-guide",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Nasıl uygulanır?" },
    { "type": "textarea", "id": "text", "label": "Metin" },
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "image_picker", "id": "ozet", "label": "Özet görsel", "info": "Bölümün altında tam genişlikte gösterilir (firmanın tek görsellik rehberi)." },
    { "type": "checkbox", "id": "yalniz_ozet", "label": "Yalnız özet görseli göster", "default": false, "info": "Açıkken ekranda yalnız özet görsel görünür; başlık ve içerik arama motorları ve ekran okuyucular için sayfada metin olarak kalır (görünmez)." }
  ],
  "blocks": [
    { "type": "step", "name": "Adım", "limit": 8, "settings": [
      { "type": "text", "id": "title", "label": "Başlık", "default": "Adım" },
      { "type": "textarea", "id": "text", "label": "Metin" },
      { "type": "image_picker", "id": "image", "label": "Görsel" }
    ] }
  ],
  "presets": [{ "name": "Adım adım anlatım" }]
}
{% endschema %}
