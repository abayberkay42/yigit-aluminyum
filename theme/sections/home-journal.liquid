{%- comment -%}
  Ana sayfanın altındaki blog bölümü: görselli kartlar. Seçilen blogun en yeni yazıları listelenir;
  ayrıca elle "yazı" blokları eklenebilir (henüz blog yazısı yoksa sitedeki rehber sayfalarına yönlendirmek için).
  Yazının kendi görseli yoksa bölümün "Yedek görsel" ayarı kullanılır; o da yoksa kart yazıyla görünür.
  Yazı yoksa ve blok da yoksa bölüm hiç görünmez.
{%- endcomment -%}
{%- liquid
  assign blog = section.settings.blog
  assign sayi = section.settings.count | default: 3
  assign eller = section.blocks | where: 'type', 'post'
  assign yazi_sayisi = 0
  if blog != blank
    assign yazi_sayisi = blog.articles.size
  endif
  assign toplam = yazi_sayisi | plus: eller.size
-%}
{%- if toplam > 0 -%}
  <section class="journal" aria-labelledby="JournalTitle-{{ section.id }}">
    <header class="journal__head">
      {%- if section.settings.eyebrow != blank -%}<p class="journal__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="journal__title" id="JournalTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="journal__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- if blog != blank -%}
        <a class="journal__all" href="{{ blog.url }}">
          {{ section.settings.link_label | default: blog.title }}
          <svg class="icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </header>

    <ul class="journal__grid" role="list">
      {%- for article in blog.articles limit: sayi -%}
        {%- assign gorsel = article.image | default: section.settings.fallback_image -%}
        <li class="jcard reveal" data-reveal style="--i: {{ forloop.index0 }}">
          <a class="jcard__link" href="{{ article.url }}">
            {%- if gorsel -%}
              <span class="jcard__media">{{ gorsel | image_url: width: 1000 | image_tag: widths: '400,600,800,1000', sizes: '(min-width: 64em) 30vw, 85vw', loading: 'lazy', alt: '' }}</span>
            {%- endif -%}
            <span class="jcard__body">
              <span class="jcard__meta"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d.%m.%Y' }}</time></span>
              <span class="jcard__title">{{ article.title }}</span>
              <span class="jcard__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</span>
              <span class="jcard__go">
                {{ 'home.journal.read' | t }}
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </span>
          </a>
        </li>
      {%- endfor -%}
      {%- for block in eller -%}
        {%- assign gorsel = block.settings.image | default: section.settings.fallback_image -%}
        <li class="jcard reveal" data-reveal style="--i: {{ forloop.index0 | plus: yazi_sayisi }}" {{ block.shopify_attributes }}>
          <a class="jcard__link" href="{{ block.settings.url }}">
            {%- if gorsel -%}
              <span class="jcard__media">{{ gorsel | image_url: width: 1000 | image_tag: widths: '400,600,800,1000', sizes: '(min-width: 64em) 30vw, 85vw', loading: 'lazy', alt: '' }}</span>
            {%- endif -%}
            <span class="jcard__body">
              {%- if block.settings.meta != blank -%}<span class="jcard__meta">{{ block.settings.meta }}</span>{%- endif -%}
              <span class="jcard__title">{{ block.settings.title }}</span>
              {%- if block.settings.text != blank -%}<span class="jcard__excerpt">{{ block.settings.text }}</span>{%- endif -%}
              {%- liquid
                assign oku = block.settings.link_label
                if oku == blank
                  assign oku = 'home.journal.read' | t
                endif
              -%}
              <span class="jcard__go">
                {{ oku }}
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Blog (ana sayfa)",
  "class": "section-home-journal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Bilgi" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Profil seçerken işinize yarayacak yazılar" },
    { "type": "textarea", "id": "text", "label": "Açıklama" },
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Bu blogun en yeni yazıları listelenir." },
    { "type": "range", "id": "count", "label": "Kaç yazı", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "image_picker", "id": "fallback_image", "label": "Yedek görsel", "info": "Yazının kendi görseli yoksa kartta bu görünür." },
    { "type": "text", "id": "link_label", "label": "Bağlantı metni", "info": "Boşsa blogun adı." }
  ],
  "blocks": [
    { "type": "post", "name": "Elle yazı", "limit": 6, "settings": [
      { "type": "text", "id": "title", "label": "Başlık" },
      { "type": "textarea", "id": "text", "label": "Kısa metin" },
      { "type": "text", "id": "meta", "label": "Üst bilgi", "info": "Tarih ya da tür (ör. Rehber)." },
      { "type": "url", "id": "url", "label": "Bağlantı" },
      { "type": "image_picker", "id": "image", "label": "Görsel" },
      { "type": "text", "id": "link_label", "label": "Kart bağlantı metni", "info": "Boşsa \"Yazıyı okuyun\"." }
    ] }
  ],
  "presets": [{ "name": "Blog (ana sayfa)" }]
}
{% endschema %}
