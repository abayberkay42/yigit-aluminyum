{%- comment -%}
  Yapılandırılmış veri (JSON-LD), layout'tan çağrılır.
  Ana sayfa: firma (Organization) + site (WebSite, arama). Ürün: Product + her varyant için Offer.
  Ürün, koleksiyon, sayfa, blog ve yazı: sayfa yolu (BreadcrumbList). SSS bölümü kendi FAQPage verisini basar.
  Firma bilgileri: Tema ayarları > Firma bilgileri. Görsel adresi protokolsüz gelirse https eklenir.
{%- endcomment -%}
{%- liquid
  assign org_id = shop.url | append: '/#organization'
  assign home_url = shop.url | append: routes.root_url | replace: '//', '/' | replace: ':/', '://'
  assign same_as = settings.org_same_as | strip | newline_to_br | split: '<br />'
-%}
{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":{{ org_id | json }},"name":{{ shop.name | json }},"url":{{ shop.url | json }}
{%- comment -%} Logo ayarı boşsa temayla gelen logo kullanılır; arama motoruna her hâlükârda logo gider. {%- endcomment -%}
{%- if settings.logo -%},"logo":{{ settings.logo | image_url: width: 600 | prepend: 'https:' | replace: 'https:https:', 'https:' | json }}
{%- else -%},"logo":{{ 'yigit-logo-2x.png' | asset_url | prepend: shop.url | replace: 'https:https:', 'https:' | json }}{%- endif -%}
{%- if settings.org_founding != blank -%},"foundingDate":{{ settings.org_founding | json }}{%- endif -%}
{%- if settings.org_email != blank -%},"email":{{ settings.org_email | json }}{%- endif -%}
{%- if settings.org_phone != blank -%},"telephone":{{ settings.org_phone | json }}{%- endif -%}
{%- if settings.org_locality != blank -%},"address":{"@type":"PostalAddress","addressLocality":{{ settings.org_locality | json }},"addressRegion":{{ settings.org_region | json }},"addressCountry":"TR"}{%- endif -%}
{%- if settings.org_same_as != blank -%},"sameAs":[{%- for u in same_as -%}{{ u | strip | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}]{%- endif -%}
},{"@type":"WebSite","@id":{{ shop.url | append: '/#website' | json }},"url":{{ home_url | json }},"name":{{ shop.name | json }},"inLanguage":{{ request.locale.iso_code | json }},"publisher":{"@id":{{ org_id | json }}},"potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":{{ shop.url | append: routes.search_url | append: '?q={search_term_string}' | json }}},"query-input":"required name=search_term_string"}}]}
</script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
{%- assign p_url = shop.url | append: product.url -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Product","@id":{{ p_url | append: '#product' | json }},"name":{{ product.title | json }},"url":{{ p_url | json }},"description":{{ product.description | strip_html | strip_newlines | strip | truncate: 5000 | json }},
{%- if product.images.size > 0 -%}"image":[{%- for img in product.images limit: 6 -%}{{ img | image_url: width: 1600 | prepend: 'https:' | replace: 'https:https:', 'https:' | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}],{%- endif -%}
{%- if product.type != blank -%}"category":{{ product.type | json }},{%- endif -%}
"brand":{"@type":"Brand","name":{{ product.vendor | default: shop.name | json }}},
"offers":[{%- for v in product.variants -%}{"@type":"Offer",{%- if v.sku != blank -%}"sku":{{ v.sku | json }},{%- endif -%}"name":{% if product.has_only_default_variant %}{{ product.title | json }}{% else %}{{ product.title | append: ' - ' | append: v.title | json }}{% endif %},"url":{{ shop.url | append: v.url | json }},"price":{{ v.price | divided_by: 100.0 | json }},"priceCurrency":{{ cart.currency.iso_code | default: shop.currency | json }},"availability":"https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}","itemCondition":"https://schema.org/NewCondition","seller":{"@id":{{ org_id | json }}}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
</script>
{%- endif -%}

{%- assign pt = request.page_type -%}
{%- if pt == 'product' or pt == 'collection' or pt == 'page' or pt == 'blog' or pt == 'article' -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":{{ 'general.home' | t | json }},"item":{{ home_url | json }}}
{%- case pt -%}
  {%- when 'product' -%}
    {%- if collection -%},{"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ shop.url | append: collection.url | json }}}
    {%- else -%},{"@type":"ListItem","position":2,"name":{{ 'collections.all_groups' | t | json }},"item":{{ shop.url | append: routes.collections_url | json }}}{%- endif -%}
    ,{"@type":"ListItem","position":3,"name":{{ product.title | json }},"item":{{ shop.url | append: product.url | json }}}
  {%- when 'collection' -%}
    ,{"@type":"ListItem","position":2,"name":{{ 'collections.all_groups' | t | json }},"item":{{ shop.url | append: routes.collections_url | json }}},{"@type":"ListItem","position":3,"name":{{ collection.title | json }},"item":{{ shop.url | append: collection.url | json }}}
  {%- when 'page' -%}
    ,{"@type":"ListItem","position":2,"name":{{ page.title | json }},"item":{{ shop.url | append: page.url | json }}}
  {%- when 'blog' -%}
    ,{"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":{{ shop.url | append: blog.url | json }}}
  {%- when 'article' -%}
    ,{"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":{{ shop.url | append: blog.url | json }}},{"@type":"ListItem","position":3,"name":{{ article.title | json }},"item":{{ shop.url | append: article.url | json }}}
{%- endcase -%}
]}
</script>
{%- endif -%}
