{%- comment -%}
  Ürün kartı. Parametreler: product, sizes (isteğe bağlı, görsel sizes değeri),
  loading (isteğe bağlı: ilk ekranda görünen kartlarda 'eager', diğerlerinde varsayılan 'lazy').
  İlk ekrandaki görsele tembel yükleme verilmez; tarayıcı onu sonraya bırakır ve görsel geç gelir.
  Tüm kart tek bağlantıdır (başlıktaki bağlantı kartı kaplar). İkinci görsel varsa üzerine gelince görünür
  (mağazada ikinci görsel çoğunlukla uygulama fotoğrafı). Renk seçeneği varsa renk noktaları, diğer seçenek için sayı.
{%- endcomment -%}
{%- liquid
  assign img = product.featured_image
  assign img2 = product.images[1]
  assign sizes = sizes | default: '(min-width: 64em) 23vw, 46vw'
  assign loading = loading | default: 'lazy'
  assign color_values = blank
  assign other_count = 0
  assign other_name = ''
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname == 'renk' or oname == 'color' or oname == 'colour'
      assign color_values = option.values
    elsif option.values.size > 1
      assign other_count = option.values.size
      assign other_name = option.name | downcase
    endif
  endfor
-%}
<article class="card">
  <div class="card__media">
    {%- if img -%}
      <span class="card__img">{{ img | image_url: width: 720 | image_tag: widths: '360,540,720', sizes: sizes, loading: loading, alt: '' }}</span>
      {%- if img2 -%}
        <span class="card__img card__img--alt">{{ img2 | image_url: width: 720 | image_tag: widths: '360,540,720', sizes: sizes, loading: 'lazy', alt: '' }}</span>
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'card__placeholder' }}
    {%- endif -%}
  </div>
  <div class="card__body">
    {%- if product.type != blank -%}<p class="card__type">{{ product.type }}</p>{%- endif -%}
    <h3 class="card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <p class="card__price">{% render 'price', product: product %}</p>
    {%- if color_values != blank or other_count > 0 -%}
      <div class="card__opts">
        {%- if color_values != blank -%}
          <ul class="card__swatches" role="list" aria-label="{{ 'products.colors' | t }}">
            {%- for v in color_values limit: 7 -%}
              <li class="swatch" data-swatch="{{ v | escape }}" title="{{ v | escape }}"><span class="visually-hidden">{{ v }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if other_count > 0 -%}<span class="card__more">{{ other_count }} {{ other_name }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%}
    Hızlı ekleme (src/js/store/quick-add.js). Farenin olduğu cihazda görselin altından üzerine gelince açılır,
    dokunmatik cihazda kartın altında hep görünür. Renk dışında seçimi gereken ürün (ör. boy) sepete buradan
    eklenmez: düğme ürün sayfasına götürür. Kartın tamamı bağlantı olduğu için bu alan bağlantının üstünde durur.
  {%- endcomment -%}
  {%- assign ilk = product.selected_or_first_available_variant -%}
  <div class="card__quick{% if color_values != blank and color_values.size > 1 %} card__quick--renk{% endif %}" data-quick>
    {%- if other_count > 0 -%}
      <a class="card__quick-btn" href="{{ product.url }}">
        <span>{{ 'products.choose_options' | t }}</span>
        <svg class="card__quick-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M3.5 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    {%- else -%}
      {%- if color_values != blank and color_values.size > 1 -%}
        {%- assign renk_index = 0 -%}
        {%- for option in product.options_with_values -%}
          {%- assign oname = option.name | downcase -%}
          {%- if oname == 'renk' or oname == 'color' or oname == 'colour' -%}{%- assign renk_index = forloop.index0 -%}{%- endif -%}
        {%- endfor -%}
        <div class="card__quick-renkler" role="group" aria-label="{{ 'products.colors' | t }}: {{ product.title | escape }}">
          {%- for v in color_values limit: 6 -%}
            {%- assign secili = false -%}
            {%- if ilk.options[renk_index] == v -%}{%- assign secili = true -%}{%- endif -%}
            <button type="button" class="card__quick-renk" data-quick-renk="{{ v | escape }}" aria-pressed="{{ secili }}" title="{{ v | escape }}">
              <span class="swatch" data-swatch="{{ v | escape }}"></span><span class="visually-hidden">{{ v }}</span>
            </button>
          {%- endfor -%}
        </div>
        <script type="application/json" data-quick-varyant>[{%- for vr in product.variants -%}{"id":{{ vr.id }},"r":{{ vr.options[renk_index] | json }},"a":{{ vr.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]</script>
      {%- endif -%}
      <button type="button" class="card__quick-btn" data-quick-add data-id="{{ ilk.id }}"
        data-t-add="{{ 'products.add_to_cart' | t | escape }}" data-t-adding="{{ 'products.adding' | t | escape }}"
        data-t-added="{{ 'products.added_short' | t | escape }}" data-t-sold-out="{{ 'products.sold_out' | t | escape }}"
        data-t-error="{{ 'products.error' | t | escape }}"
        {% unless ilk.available %}disabled{% endunless %}>
        <svg class="card__quick-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M3 4h2.2l2.3 11h10.2l2-8H6.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="19.5" r="1.3" fill="currentColor"/><circle cx="16.5" cy="19.5" r="1.3" fill="currentColor"/></svg>
        <span data-quick-label>{% if ilk.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
        <span class="visually-hidden">: {{ product.title }}</span>
      </button>
    {%- endif -%}
    <p class="visually-hidden" role="status" data-quick-status></p>
  </div>
</article>
