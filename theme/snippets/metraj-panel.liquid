{%- comment -%}
  Metraj fiyatı paneli (ürün sayfası). Firmanın metre başı iskonto tablosu: miktar arttıkça metre fiyatı liste
  fiyatından dip fiyata doğru iner. Canlı hesap src/js/store/product.js + metraj.js; JS yokken en az miktardaki
  fiyat görünür. Metraj fiyat tablosu ve açıklama notu müşteri isteğiyle kaldırıldı (2026-09-19): alıcı yalnız kendi
  miktarının fiyatını ve indirimini görür.
  Parametreler: blok, liste (kuruş), dip (TL), esik (m), baslangic (m), en_az, kisa (birim kısaltması)
{%- endcomment -%}
{%- liquid
  assign bas_oran = baslangic | times: 100.0 | divided_by: esik | at_most: 100
  assign baslik = blok.settings.label
  if baslik == blank
    assign baslik = 'products.metraj_title' | t
  endif
  assign t_for = 'products.metraj_for' | t
  assign t_start = 'products.metraj_start' | t
  assign ilk_metin = en_az | append: ' ' | append: kisa
  assign bas_metin = baslangic | append: ' ' | append: kisa
-%}
<div
  class="metraj"
  data-metraj
  data-dip="{{ dip }}"
  data-esik="{{ esik }}"
  data-bas="{{ baslangic }}"
  data-kisa="{{ kisa }}"
  data-t-for="{{ t_for | escape }}"
  data-t-off="{{ 'products.metraj_off' | t | escape }}"
  data-t-start="{{ t_start | escape }}"
  data-t-left="{{ 'products.metraj_left' | t | escape }}"
  data-t-floor="{{ 'products.metraj_floor' | t | escape }}"
  {{ blok.shopify_attributes }}
>
  <div class="metraj__ust">
    <p class="metraj__k">{{ baslik }}</p>
    <p class="metraj__rozet" data-metraj-off hidden></p>
  </div>
  <p class="metraj__fiyat" aria-live="polite">
    <strong class="metraj__v fiyat-neon" data-metraj-fiyat>{{ liste | money }}</strong>
    <span class="metraj__birim">/ {{ kisa }}</span>
    <s class="metraj__liste" data-metraj-liste hidden><span class="visually-hidden">{{ 'products.metraj_list' | t }}: </span>{{ liste | money }}</s>
  </p>
  <p class="metraj__for" data-metraj-for>{{ t_for | replace: '[m]', ilk_metin }}</p>

  <div class="metraj__ray" aria-hidden="true" style="--bas: {{ bas_oran }}%">
    <span class="metraj__dolu" data-metraj-dolu></span>
    <span class="metraj__isaret metraj__isaret--bas"></span>
  </div>
  <div class="metraj__olcek" aria-hidden="true" style="--bas: {{ bas_oran }}%">
    <span>0</span>
    <span class="metraj__olcek-bas">{{ baslangic }} {{ kisa }}</span>
    <span>{{ esik }} {{ kisa }}</span>
  </div>
  <p class="metraj__durum" data-metraj-durum>{{ t_start | replace: '[m]', bas_metin }}</p>

</div>
