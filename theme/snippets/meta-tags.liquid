{%- comment -%}
  Paylaşım etiketleri (Open Graph, Twitter). Görsel: sayfanın kendi görseli (ürün, koleksiyon, yazı),
  yoksa Tema ayarları > Firma bilgileri > Paylaşım görseli.
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_desc = page_description | default: shop.description | strip_html
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
  assign og_image = page_image | default: settings.share_image
  case request.locale.iso_code
    when 'tr'
      assign og_locale = 'tr_TR'
    when 'en'
      assign og_locale = 'en_US'
    else
      assign og_locale = request.locale.iso_code
  endcase
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_desc | escape }}">
<meta property="og:locale" content="{{ og_locale }}">
{%- if og_image %}
<meta property="og:image" content="{{ og_image | image_url: width: 1200 | prepend: 'https:' | replace: 'https:https:', 'https:' }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
{%- endif %}
{%- if request.page_type == 'product' %}
<meta property="product:price:amount" content="{{ product.price | divided_by: 100.0 }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code | default: shop.currency }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | escape }}">
