{%- comment -%}
  Taksit kartları. Ayarlar: Tema ayarları > Taksit (taksit sayısı, not, 9 kart programı).
  Kartlar PayTR'nin taksit desteklediği programlardır (paytr.com, 2026-09-15). Logolar programların resmi sitelerinden
  alınıp temaya eklendi (assets/taksit-*): Bonus, World, Axess (yıldönümü yazısı kırpıldı), CardFinans (QNB),
  Paraf ve Sağlam Kart (beyaz logo, markanın zemin rengiyle), Bankkart; Advantage için HSBC'nin resmi kart görseli.
  Maximum'un sitesine erişilemediği için logosu yok: yazıyla gösterilir.
  Öncelik: "Logo" ayarına yüklenen görsel > temadaki dosya > yazı.
  Parametre: gorunum = 'ozet' (ürün sayfası, fiyatın altında) | 'tam' (taksit bölümü)
{%- endcomment -%}
{%- if settings.taksit_etkin -%}
  {%- liquid
    assign sayi = settings.taksit_sayi | default: 12
    assign gorunum = gorunum | default: 'ozet'
  -%}
  {%- capture kartlar -%}
    {%- for i in (1..9) -%}
      {%- liquid
        assign on = 'taksit_kart_' | append: i
        assign k_ad = on | append: '_ad'
        assign k_banka = on | append: '_banka'
        assign k_logo = on | append: '_logo'
        assign k_dosya = on | append: '_dosya'
        assign k_zemin = on | append: '_zemin'
        assign ad = settings[k_ad]
        assign banka = settings[k_banka]
        assign logo = settings[k_logo]
        assign dosya = settings[k_dosya]
        assign zemin = settings[k_zemin] | default: '#ffffff'
        assign aciklama = ad
        if banka != blank
          assign aciklama = ad | append: ' (' | append: banka | append: ')'
        endif
      -%}
      {%- if ad != blank -%}
        <li class="kart kart--{{ gorunum }}">
          <span class="kart__logo-kutu{% if dosya contains 'advantage' and logo == blank %} kart__logo-kutu--gorsel{% endif %}" style="--zemin: {{ zemin }}">
            {%- if logo -%}
              {{ logo | image_url: width: 360 | image_tag: widths: '180,360', sizes: '8rem', loading: 'lazy', alt: aciklama, class: 'kart__logo' }}
            {%- elsif dosya != blank -%}
              {%- comment -%} Ölçü nitelikleri kutunun oranında (1.9): CSS logoyu oranını koruyarak sığdırır {%- endcomment -%}
              <img class="kart__logo" src="{{ dosya | asset_url }}" width="190" height="100" alt="{{ aciklama | escape }}" loading="lazy" decoding="async">
            {%- else -%}
              <span class="kart__yazi">{{ ad }}</span>
              <span class="visually-hidden">{% if banka != blank %} ({{ banka }}){% endif %}</span>
            {%- endif -%}
          </span>
          {%- if gorunum == 'tam' -%}
            <span class="kart__bilgi">
              <span class="kart__isim">{{ ad }}</span>
              {%- if banka != blank -%}<span class="kart__banka">{{ banka }}</span>{%- endif -%}
              <span class="kart__sayi">{{ 'products.inst_count_label' | t: count: sayi }}</span>
            </span>
          {%- endif -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if gorunum == 'ozet' -%}
    <div class="taksit-ozet">
      <p class="taksit-ozet__metin">
        <svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><rect x="3" y="5.5" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3 10h18M6.5 15h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <strong>{{ 'products.inst_line' | t: count: sayi }}</strong>
        <a href="#taksit">{{ 'products.inst_more' | t }}</a>
      </p>
      <ul class="taksit-ozet__kartlar" role="list" aria-label="{{ 'products.inst_cards' | t }}">{{ kartlar }}</ul>
    </div>
  {%- else -%}
    <ul class="taksit-izgara" role="list" aria-label="{{ 'products.inst_cards' | t }}">{{ kartlar }}</ul>
    {%- if settings.taksit_not != blank -%}<p class="taksit-not">{{ settings.taksit_not }}</p>{%- endif -%}
  {%- endif -%}
{%- endif -%}
