{%- comment -%}
  Sağ altta sabit hızlı iletişim düğmeleri: WhatsApp ve telefon.
  Ayarlar: Tema ayarları > İletişim düğmeleri. Numara boşsa düğme basılmaz.
  WhatsApp numarası boşsa Firma bilgileri > Telefon kullanılır.
  Mesaj sayfaya göre değişir: ürün sayfasında ürün adı, koleksiyon sayfasında grup adı hazır mesaja girer.
  Davranış (src/js/sections/dock.js): girişte sırayla belirir, altbilgiye ve 3B sahne düğmelerine binmez
  (onların üstüne gelince kenara çekilir), oturumda bir kez dikkat çekmek için hafifçe yanar.
{%- endcomment -%}
{%- liquid
  assign wa = settings.dock_whatsapp | default: settings.org_phone
  assign wa_no = wa | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  # "0532..." gibi başında 0 ile yazılmışsa wa.me için ülke koduna çevir
  assign bas = wa_no | slice: 0
  if bas == '0'
    assign wa_no = wa_no | remove_first: '0' | prepend: '90'
  endif
  assign tel_no = settings.org_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'

  case template.name
    when 'product'
      capture mesaj
        echo 'products.whatsapp_message' | t: title: product.title
      endcapture
    when 'collection'
      capture mesaj
        echo 'general.dock.message_collection' | t: title: collection.title
      endcapture
    else
      assign mesaj = settings.dock_message | default: ''
      if mesaj == blank
        capture mesaj
          echo 'general.dock.message' | t
        endcapture
      endif
  endcase

  assign goster_wa = false
  if settings.dock_whatsapp_enabled and wa_no != blank
    assign goster_wa = true
  endif
  assign goster_tel = false
  if settings.dock_phone_enabled and tel_no != blank
    assign goster_tel = true
  endif
-%}
{%- if goster_wa or goster_tel -%}
  <aside class="dock" data-dock aria-label="{{ 'general.dock.label' | t }}">
    {%- if goster_wa -%}
      <a class="dock__btn dock__btn--wa" href="https://wa.me/{{ wa_no }}?text={{ mesaj | strip | url_encode }}" target="_blank" rel="noopener" data-dock-btn>
        <span class="dock__label" aria-hidden="true">{{ 'general.dock.whatsapp' | t }}</span>
        <span class="dock__balon" aria-hidden="true">{{ 'general.dock.teaser' | t }}</span>
        <span class="dock__disc">
          <svg class="dock__icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M12 3.2a8.8 8.8 0 0 0-7.6 13.2L3.3 20.7l4.4-1.1A8.8 8.8 0 1 0 12 3.2Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 8.6c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.6 1.5c.1.2 0 .4-.1.6l-.4.5c-.1.1-.2.3 0 .5.5.9 1.3 1.6 2.2 2.1.2.1.4.1.5 0l.6-.6c.2-.2.4-.2.6-.1l1.5.7c.2.1.3.3.3.5 0 .7-.5 1.4-1.2 1.6-.7.2-1.6.1-3-.6a8 8 0 0 1-3.2-3.1c-.7-1.2-.8-2.2-.3-3Z" fill="currentColor"/></svg>
        </span>
        <span class="visually-hidden">{{ 'general.dock.whatsapp_a11y' | t }} ({{ 'general.new_tab' | t }})</span>
      </a>
    {%- endif -%}
    {%- if goster_tel -%}
      <a class="dock__btn dock__btn--tel" href="tel:{{ tel_no }}" data-dock-btn>
        <span class="dock__label" aria-hidden="true">{{ settings.org_phone }}</span>
        <span class="dock__disc">
          <svg class="dock__icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M6.6 3.6h2.6l1.5 4-1.9 1.3a10.6 10.6 0 0 0 6.3 6.3l1.3-1.9 4 1.5v2.6a1.8 1.8 0 0 1-1.9 1.8A15.6 15.6 0 0 1 4.8 5.5a1.8 1.8 0 0 1 1.8-1.9Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </span>
        <span class="visually-hidden">{{ 'general.dock.call_a11y' | t: phone: settings.org_phone }}</span>
      </a>
    {%- endif -%}
  </aside>
{%- endif -%}
