{%- comment -%}
  Sosyal medya bağlantıları. Adresler Tema ayarları > Firma bilgileri > "Sosyal medya adresleri"nden gelir
  (her satıra bir adres); adres yoksa hiçbir şey basılmaz. Ad, adresin içinden tanınır.
  Parametreler:
    etiket   true → simgenin yanında ağın adı yazar (alt alan, iletişim sayfası)
    baslik   verilirse listenin üstünde küçük başlık
    sinif    ek sınıf (yerleşimi çağıran bölüm ayarlar)
{%- endcomment -%}
{%- assign adresler = settings.org_same_as | strip | newline_to_br | split: '<br />' -%}
{%- if adresler.size > 0 and settings.org_same_as != blank -%}
  <div class="sosyal{% if etiket %} sosyal--etiketli{% endif %}{% if sinif %} {{ sinif }}{% endif %}">
    {%- if baslik != blank -%}<p class="sosyal__h">{{ baslik }}</p>{%- endif -%}
    <ul class="sosyal__list" role="list" aria-label="{{ 'footer.social' | t }}">
      {%- for item in adresler -%}
        {%- assign url = item | strip -%}
        {%- if url == blank -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign ad = 'Web'
          if url contains 'instagram'
            assign ad = 'Instagram'
          elsif url contains 'facebook'
            assign ad = 'Facebook'
          elsif url contains 'youtube'
            assign ad = 'YouTube'
          elsif url contains 'linkedin'
            assign ad = 'LinkedIn'
          elsif url contains 'tiktok'
            assign ad = 'TikTok'
          endif
        -%}
        <li>
          <a class="sosyal__link" href="{{ url }}" rel="noopener" target="_blank">
            <span class="sosyal__ikon" aria-hidden="true">
              {%- case ad -%}
                {%- when 'Instagram' -%}
                  <svg class="icon" viewBox="0 0 24 24" width="24" height="24" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"/></svg>
                {%- when 'Facebook' -%}
                  <svg class="icon" viewBox="0 0 24 24" width="24" height="24" focusable="false"><path d="M14.5 21v-7h2.4l.4-3h-2.8V9.2c0-.9.3-1.5 1.5-1.5H17.4V5.1C17.1 5 16.2 4.9 15.2 4.9c-2.1 0-3.6 1.3-3.6 3.8V11H9v3h2.6v7z" fill="currentColor"/></svg>
                {%- when 'YouTube' -%}
                  <svg class="icon" viewBox="0 0 24 24" width="24" height="24" focusable="false"><rect x="2.5" y="5.5" width="19" height="13" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10.5 9.5l5 2.5-5 2.5z" fill="currentColor"/></svg>
                {%- when 'LinkedIn' -%}
                  <svg class="icon" viewBox="0 0 24 24" width="24" height="24" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="3" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M7.5 10v6.5M7.5 7.2v.1M11 16.5V10m0 2.2c.3-1.3 1.3-2.2 2.7-2.2 1.6 0 2.8 1 2.8 3v3.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                {%- when 'TikTok' -%}
                  <svg class="icon" viewBox="0 0 24 24" width="24" height="24" focusable="false"><path d="M13.8 3.5v9.7a3 3 0 1 1-2.6-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M13.8 5.6c.7 1.7 2.2 2.8 4.2 3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                {%- else -%}
                  <svg class="icon" viewBox="0 0 24 24" width="24" height="24" focusable="false"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 12h17M12 3.5c4 4.5 4 12.5 0 17-4-4.5-4-12.5 0-17z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
              {%- endcase -%}
            </span>
            {%- if etiket -%}
              <span class="sosyal__ad">{{ ad }}</span>
            {%- else -%}
              <span class="visually-hidden">{{ ad }}</span>
            {%- endif -%}
            <span class="visually-hidden"> ({{ 'general.new_tab' | t }})</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}
